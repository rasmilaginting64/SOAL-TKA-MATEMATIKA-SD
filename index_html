];
questions=[]; let questionPool=[];
function say(text){if(!soundOn||!("speechSynthesis"in window))return; speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(text);u.lang="id-ID";u.rate=.92;speechSynthesis.speak(u)}
function beep(ok){if(!soundOn)return;try{let c=new(window.AudioContext||window.webkitAudioContext)(),o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.frequency.value=ok?660:220;g.gain.value=.07;o.start();o.stop(c.currentTime+.13)}catch(e){}}
$("soundToggle").onclick=()=>{soundOn=!soundOn;$("soundToggle").textContent=soundOn?"🔊 Suara ON":"🔇 Suara OFF";if(!soundOn&&"speechSynthesis"in window)speechSynthesis.cancel()};
$("teacherOpen").onclick=()=>{hideAll();$("teacher").classList.remove("hidden")};
function hideAll(){["welcome","game","result","teacher"].forEach(x=>$(x).classList.add("hidden"))}
$("startBtn").onclick=()=>{
 const name=$("studentName").value.trim(),cl=$("studentClass").value,date=$("examDate").value;
 if(!name||!cl||!date){alert("Lengkapi nama, kelas, dan tanggal terlebih dahulu.");return}
 student={name,cl,date};current=0;score=0;level=1;answers=[];selected=[];
 questionPool=rawQuestions.map((q,i)=>({...q,id:i,d:i<17?1:(i<34?2:3)}));
 questions=[];hideAll();$("game").classList.remove("hidden");pickNextQuestion();
};
function pickNextQuestion(){
 const candidates=questionPool.filter(q=>q.d===level);
 const pool=candidates.length?candidates:questionPool;
 const next=pool[0];
 questionPool=questionPool.filter(q=>q.id!==next.id);
 questions.push(next);current=questions.length-1;renderQuestion();
}
function renderQuestion(){
 checked=false;let q=questions[current];$("qCounter").textContent=`Soal ${current+1}/50`;$("qTopic").textContent=q.t;$("qLevel").textContent=`Level ${level}`;$("liveScore").textContent=`Skor: ${score}`;$("progressBar").style.width=(current/50*100)+"%";$("questionText").textContent=q.q;
 $("questionVisual").classList.toggle("hidden",!q.v);$("questionVisual").textContent=q.v||"";
 $("options").innerHTML="";$("feedback").classList.add("hidden");$("answerBtn").classList.remove("hidden");$("nextBtn").classList.add("hidden");
 if(q.f==="multi"){$("questionText").textContent+=" (Pilih semua jawaban yang benar.)"}
 q.o.forEach((v,i)=>{let b=document.createElement("button");b.className="opt";b.innerHTML=`<span>${q.f==="tf"?"":String.fromCharCode(65+i)+". "}</span><span>${v}</span>`;b.onclick=()=>selectOption(i,b);$("options").appendChild(b)});
}
let selected=[];
function selectOption(i,b){if(checked)return;let q=questions[current];if(q.f==="multi"){if(selected.includes(i)){selected=selected.filter(x=>x!==i);b.classList.remove("selected")}else{selected.push(i);b.classList.add("selected")}}else{selected=[i];[...$("options").children].forEach(x=>x.classList.remove("selected"));b.classList.add("selected")}}
$("answerBtn").onclick=()=>{
 if(!selected.length){alert("Pilih jawaban terlebih dahulu.");return}
 checked=true;let q=questions[current],correct=Array.isArray(q.a)?q.a.slice().sort().join(",")===selected.slice().sort().join(","):selected[0]===q.a;
 if(correct)score+=2;
 answers.push({question:q.q,topic:q.t,correct,selected:selected.slice(),key:q.a});
 [...$("options").children].forEach((b,i)=>{let yes=Array.isArray(q.a)?q.a.includes(i):q.a===i;if(yes)b.classList.add("correct");else if(selected.includes(i))b.classList.add("wrong");b.disabled=true});
 $("feedback").className="feedback "+(correct?"good":"bad");$("feedback").innerHTML=(correct?"🌟 <b>Hebat! Jawabanmu benar.</b> ":"💪 <b>Tetap semangat! Jawaban yang tepat belum sesuai.</b> ")+q.e;
 beep(correct);$("answerBtn").classList.add("hidden");$("nextBtn").classList.remove("hidden");$("liveScore").textContent=`Skor: ${score}`;
 // Adaptive level changes based on the student's running accuracy.
 let acc=answers.filter(x=>x.correct).length/answers.length;
 // Penyesuaian kesulitan: akurasi >=80% naik ke level 3; >=55% ke level 2; selebihnya level 1.
 level=acc>=.8?3:acc>=.55?2:1;
 $("qLevel").textContent=`Level ${level}`;
};
$("nextBtn").onclick=()=>{selected=[];if(questions.length>=50)finish();else pickNextQuestion()};
$("readBtn").onclick=()=>say(questions[current].q+" "+questions[current].o.join(". "));
async function finish(){
 hideAll();$("result").classList.remove("hidden");let correct=answers.filter(x=>x.correct).length,finalScore=Math.round(correct/50*100);
 $("resultSummary").innerHTML=`<h3>${student.name} · ${student.cl}</h3><p>Jawaban benar: <b>${correct} dari 50</b></p><h2 style="color:#5146d8;font-size:42px">${finalScore}</h2><p>Level akhir: ${level}</p>`;
 $("certName").textContent=student.name;$("certClass").textContent=`Kelas ${student.cl} · SD Negeri 3 Muara Rupit`;$("certScore").textContent=`NILAI ${finalScore}`;$("certDate").textContent=`Tanggal: ${student.date}`;
 let record={...student,correct,score:finalScore,level,createdAt:new Date().toISOString(),answers};
 $("saveStatus").textContent="Menyimpan hasil...";
 try{
  if(firebaseReady){await auth.signInAnonymously().catch(()=>{});await db.collection("Hasil_TKA_Matematika").add(record);$("saveStatus").textContent="✅ Hasil berhasil disimpan ke cloud Firebase."}
  else{$("saveStatus").textContent="⚠️ Firebase belum dikonfigurasi. Hasil ini belum tersimpan ke cloud."}
 }catch(e){$("saveStatus").textContent="Gagal menyimpan ke cloud: "+e.message}
 window.lastRecord=record;
}
$("playAgain").onclick=()=>{hideAll();$("welcome").classList.remove("hidden");$("studentName").value=student.name;$("studentClass").value=student.cl;$("examDate").value=student.date};
$("printCert").onclick=()=>{let w=window.open("","_blank");if(!w){alert("Izinkan pop-up untuk mencetak sertifikat.");return}w.document.write(`<html><head><title>Sertifikat</title><style>body{font-family:Arial;padding:35px}.certificate{border:9px double #d7ad43;padding:35px;text-align:center;background:#fffdf4;color:#25265c}.student{font-size:28px;font-weight:bold;color:#138b91}h2{color:#5146d8}.sign{display:flex;justify-content:space-around;margin-top:60px}</style></head><body>${$("certificate").outerHTML}</body></html>`);w.document.close();w.print()};
$("teacherLoginBtn").onclick=async()=>{
 if(!firebaseReady){$("loginMessage").textContent="Isi firebaseConfig terlebih dahulu di index.html.";return}
 let email=$("teacherEmail").value.trim(),pass=$("teacherPassword").value;
 try{let cred=await auth.signInWithEmailAndPassword(email,pass);if(email.toLowerCase()!==TEACHER_EMAIL.toLowerCase()){await auth.signOut();throw new Error("Email ini tidak memiliki akses dasbor guru.")}$("teacherLogin").classList.add("hidden");$("teacherPanel").classList.remove("hidden");await loadTeacherData()}
 catch(e){$("loginMessage").textContent="Gagal masuk: "+e.message}
};
async function loadTeacherData(){
 try{let snap=await db.collection("Hasil_TKA_Matematika").orderBy("createdAt","desc").get();teacherRows=snap.docs.map(d=>d.data());$("totalAttempts").textContent=teacherRows.length+" percobaan";$("resultsBody").innerHTML="";
 if(!teacherRows.length)$("resultsBody").innerHTML='<tr><td colspan="6">Belum ada data.</td></tr>';
 teacherRows.forEach(r=>{let tr=document.createElement("tr");[r.name,r.cl,r.date,r.correct,r.score,r.level].forEach(v=>{let td=document.createElement("td");td.textContent=v??"";tr.appendChild(td)});$("resultsBody").appendChild(tr)})}
 catch(e){$("resultsBody").innerHTML=`<tr><td colspan="6">Tidak dapat membaca data: ${e.message}</td></tr>`}
}
$("refreshData").onclick=loadTeacherData;
$("teacherLogout").onclick=async()=>{if(auth)await auth.signOut();$("teacherLogin").classList.remove("hidden");$("teacherPanel").classList.add("hidden");$("teacherPassword").value=""};
function exportRows(){return teacherRows.map(r=>({"Nama Siswa":r.name,"Kelas":r.cl,"Tanggal":r.date,"Jawaban Benar":r.correct,"Nilai":r.score,"Level Akhir":r.level,"Waktu Simpan":r.createdAt}))}
$("exportExcel").onclick=()=>{if(!teacherRows.length)return alert("Belum ada data.");let ws=XLSX.utils.json_to_sheet(exportRows()),wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,"Hasil TKA Matematika");XLSX.writeFile(wb,"Rekap_TKA_Matematika_SD_Muara_Rupit.xlsx")};
$("exportPDF").onclick=()=>{if(!teacherRows.length)return alert("Belum ada data.");let {jsPDF}=window.jspdf,doc=new jsPDF();doc.text("REKAP HASIL TKA MATEMATIKA",14,16);doc.text("SD NEGERI 3 MUARA RUPIT",14,24);let y=36;teacherRows.forEach((r,i)=>{let line=`${i+1}. ${r.name} | ${r.cl} | ${r.date} | Benar ${r.correct}/50 | Nilai ${r.score}`;doc.text(line,14,y);y+=8;if(y>280){doc.addPage();y=18}});doc.save("Rekap_TKA_Matematika.pdf")};
$("exportWord").onclick=async()=>{if(!teacherRows.length)return alert("Belum ada data.");try{const {Document,Packer,Paragraph,TextRun}=docx;let children=[new Paragraph({children:[new TextRun({text:"REKAP HASIL TKA MATEMATIKA",bold:true,size:30})]}),new Paragraph("SD NEGERI 3 MUARA RUPIT")];teacherRows.forEach((r,i)=>children.push(new Paragraph(`${i+1}. ${r.name} | ${r.cl} | ${r.date} | Benar ${r.correct}/50 | Nilai ${r.score}`)));let d=new Document({sections:[{children}]});let blob=await Packer.toBlob(d);let a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="Rekap_TKA_Matematika.docx";a.click();URL.revokeObjectURL(a.href)}catch(e){alert("Ekspor Word gagal: "+e.message)}};
</script>
